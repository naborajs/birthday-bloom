# ==============================================================================
# Birthday Bloom v3.1 — Complete Environment Variables Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# In production (Vercel, Netlify, AWS Amplify, Docker), set these keys in your host dashboard.
#
# NOTE: All `VITE_` variables are bundled and accessible in the client browser.
# Do not store private API keys or server secrets in `VITE_` variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Identity & Personalization
# ------------------------------------------------------------------------------
# Primary name of the birthday celebrant. Setting this personalizes the entire app.
# Alias: VITE_USER_NAME
VITE_BIRTHDAY_NAME=Birthday Person
# VITE_USER_NAME=Birthday Person

# Recipient's age (number, e.g. 25). Influences dynamic titles, birthday cards, and wishes.
VITE_BIRTHDAY_AGE=25

# Recipient's gender: female | male | other
VITE_BIRTHDAY_GENDER=other

# Birthday date in ISO format (YYYY-MM-DD or YYYY-MM-DDTHH:mm:ss).
# Used for automatic password generation and age calculations. Handles 'TH' typo correction.
VITE_BIRTHDAY_DATE=2026-04-24T00:00:00

# Relationship archetype. Controls tone, emotional letters, quiz questions, and default pacing.
# Supported: partner, friend, family, sibling, brother, sister, father, mother,
#            grandfather, grandmother, uncle, aunt, cousin, son, daughter, guardian,
#            colleague, mentor, custom. (Aliases: love, bestie, mom, dad, grandpa, grandma, work, teacher)
VITE_BIRTHDAY_RELATIONSHIP=friend

# Name of the person giving the wish (used in letters, cards, and dynamic footer signoff).
# Alias: VITE_WISHER_NAME
VITE_BIRTHDAY_WISHER_NAME=Alex
# VITE_WISHER_NAME=Alex

# ------------------------------------------------------------------------------
# 2. Multi-Language Localization (i18n)
# ------------------------------------------------------------------------------
# Language options:
#   - en : English (Default)
#   - bn : Bengali / বাংলা (Eastern Nagari typography & cultural letters)
#   - hi : Hindi / हिन्दी (Devanagari typography & respectful honorifics)
#   - fr : French / Français (European typography & poetic expressions)
# Alias: VITE_LANG (Accepts 'bengali', 'bangla', 'hindi', 'french', 'francais')
VITE_LANGUAGE=en
# VITE_LANG=en

# ------------------------------------------------------------------------------
# 3. Aesthetics, Themes & Emojis
# ------------------------------------------------------------------------------
# Primary accent hex color (e.g. #FF6B6B, #00C2FF, #FFD700, #A855F7).
# Generates dynamic HSL CSS variable tokens injected into :root.
# Aliases: VITE_THEME_COLOR, VITE_FAVORITE_COLOR
VITE_BIRTHDAY_COLOR=#FF6B6B
# VITE_THEME_COLOR=#FF6B6B
# VITE_FAVORITE_COLOR=#FF6B6B

# Comma-separated list of interests/hobbies.
# Generates custom Lucide icons, interest badges, and dynamic quiz questions.
# Supported: car, music, art, coding, gaming, nature, travel, food, sport, space
# Alias: VITE_FAVORITE_ITEMS
VITE_BIRTHDAY_INTERESTS=Gaming,Music,Travel
# VITE_FAVORITE_ITEMS=Gaming,Music,Travel

# Comma or pipe-separated custom burst emojis for cursor trails and interactive clicks.
# Alias: VITE_BIRTHDAY_EMOJIS
VITE_FAVORITE_EMOJIS=🎉,💖,✨,🎂,🌸
# VITE_BIRTHDAY_EMOJIS=🎉,💖,✨,🎂,🌸

# ------------------------------------------------------------------------------
# 4. Storytelling, Letters & Custom Messages
# ------------------------------------------------------------------------------
# Custom short message displayed across message cards and letter overlays.
# Alias: VITE_CUSTOM_MESSAGE
VITE_BIRTHDAY_CUSTOM_MESSAGE=Have the most amazing birthday ever!
# VITE_CUSTOM_MESSAGE=Have the most amazing birthday ever!

# Heading title for the emotional letter modal.
# Alias: VITE_CARD_TITLE_SURPRISE
VITE_BIRTHDAY_LETTER_TITLE=To My Favorite Person
# VITE_CARD_TITLE_SURPRISE=To My Favorite Person

# Full custom letter body. Supports '\n' for line breaks. Replaces template letters when set.
VITE_BIRTHDAY_LETTER_OVERRIDE=Dear Birthday Star,\n\nToday is your day. Every moment with you matters.\n\nWith love,\nAlex

# Special memories sequence (rendered in FinalSurprise).
# Format: Title;image_url|Title;image_url (image_url is optional).
# If left empty, the section and video embed are cleanly hidden.
VITE_SPECIAL_MEMORIES=First celebration;https://images.unsplash.com/photo-1513151233558-d860c5398176|Unforgettable trip;https://images.unsplash.com/photo-1492684223066-81342ee5ff30

# ------------------------------------------------------------------------------
# 5. Media Assets (Photos & Videos)
# ------------------------------------------------------------------------------
# Photos: Provide a comma/pipe-separated list or JSON array in VITE_PHOTOS, or use VITE_PHOTO_1..6.
# If no photos are provided, an elegant localized placeholder card is displayed automatically.
VITE_PHOTOS=
VITE_PHOTO_1=
VITE_PHOTO_2=
VITE_PHOTO_3=
VITE_PHOTO_4=
VITE_PHOTO_5=
VITE_PHOTO_6=

# Pipe or comma-separated captions for gallery photos.
VITE_PHOTO_CAPTIONS=Our favorite memory|A day worth keeping|The smile that says everything

# Video URLs (YouTube, Vimeo, or direct MP4 links).
VITE_VIDEO_1=
VITE_VIDEO_2=
VITE_VIDEO_3=

# Final video URL embedded in the grand finale surprise screen.
VITE_FINAL_VIDEO_URL=

# ------------------------------------------------------------------------------
# 6. Audio & Sensory Subsystem
# ------------------------------------------------------------------------------
# Background music audio file URL (MP3/OGG/AAC).
# Alias: VITE_SOUND_URL
VITE_BGM_URL=https://assets.mixkit.co/active_storage/music/2869/2869-preview.mp3
# VITE_SOUND_URL=https://assets.mixkit.co/active_storage/music/2869/2869-preview.mp3

# Toggle interactive UI sound effects (clicks, chimes, pops, fireworks, cake cuts).
VITE_SOUND_EFFECTS=true

# ------------------------------------------------------------------------------
# 7. Section Visibility & Navigation Controls
# ------------------------------------------------------------------------------
# Toggle 3D WebGL cake cutting and candle blowout scene (true | false)
VITE_SHOW_CAKE_SECTION=true

# Toggle photo gallery carousel section (true | false)
# Alias: VITE_SHOW_PHOTOS_SECTION
VITE_SHOW_PHOTO_SECTION=true
# VITE_SHOW_PHOTOS_SECTION=true

# Toggle personalized trivia quiz section (true | false)
VITE_SHOW_QUIZ_SECTION=true

# Toggle interactive HeartTree growth animation (true | false)
VITE_SHOW_HEART_TREE_SECTION=true

# Toggle video gallery carousel (true | false)
VITE_SHOW_VIDEO_SECTION=true

# Toggle grand finale gift & confetti burst screen (true | false)
VITE_SHOW_FINAL_SURPRISE=true

# Toggle gift box reveal modal (true | false)
VITE_SHOW_GIFT_SECTION=true

# Toggle skip intro button on splash and cinematic intro screens (true | false)
VITE_SHOW_SKIP_BUTTON=true

# ------------------------------------------------------------------------------
# 8. Animation Pacing, Density & Accessibility
# ------------------------------------------------------------------------------
# Storytelling animation pacing: slow | moderate | fast (Defaults by relationship if unset)
VITE_ANIMATION_SPEED=moderate

# Visual particle and animation density: low | medium | high
VITE_ANIMATION_INTENSITY=high

# Base ambient particle count for background canvases (default: 25)
VITE_PARTICLE_COUNT=25

# Accessibility override: Force reduced motion mode (true | false).
# Actively consumed in useBirthdayStore.ts and CakeCutting.tsx to disable heavy spring animations,
# 3D transforms, and complex particle burst physics for sensitive users or low-power devices.
VITE_REDUCED_MOTION=false

# ------------------------------------------------------------------------------
# 9. Password Gatekeeper (Secret Vault)
# ------------------------------------------------------------------------------
# Mandate passcode challenge before accessing the celebration (true | false).
# If true and VITE_PASSWORD is empty, passcode is auto-derived from VITE_BIRTHDAY_DATE.
VITE_PASSWORD_REQUIRED=false

# Explicit password string override (e.g. 0424, secret2026).
VITE_PASSWORD=

# Text hint displayed below the passcode input fields.
VITE_PASSWORD_HINT=

# Expected password format hint displayed on lock screen:
# Options: MMDD (default) | DDMM | YYYYMMDD | YYYY-MM-DD | MM-DD | DD-MM | YYYY
VITE_PASSWORD_FORMAT=MMDD

# ------------------------------------------------------------------------------
# 10. Family Mode & Relationship Metadata
# ------------------------------------------------------------------------------
# Family member archetype:
# Options: brother | sister | father | mother | grandfather | grandmother |
#          uncle | aunt | cousin | son | daughter | guardian | friend | custom
VITE_FAMILY_MEMBER_TYPE=friend

# Preferred affectionate name or nickname override
VITE_FAMILY_PREFERRED_NAME=

# Comma-separated list of family nicknames
VITE_FAMILY_NICKNAMES=

# Custom relationship badge label (e.g. "Favorite Chachu", "Best Big Bro")
VITE_FAMILY_RELATIONSHIP_LABEL=

# Closeness rating scale from 1 to 10 (default: 7)
VITE_FAMILY_CLOSENESS=7

# Number of years of shared history / friendship (number)
VITE_FAMILY_YEARS_KNOWN=

# Family branch side: maternal | paternal | both | chosen | unknown
VITE_FAMILY_SIDE=unknown

# Privacy level: public | family | private
VITE_FAMILY_PRIVACY=family

# Allow exporting and downloading family memory cards (true | false)
VITE_FAMILY_ALLOW_EXPORT=true

# Advanced: Full JSON string representing a complete FamilyMemberProfile schema.
# When provided, this takes precedence over individual VITE_FAMILY_* fields.
VITE_FAMILY_PROFILE_JSON=
